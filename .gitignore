# =========================
# Monorepo root .gitignore
# Covers frontend/ (Next.js) + backend/ (Express)
# =========================

# ----- Dependencies -----
node_modules/
**/node_modules/

# Yarn / pnpm
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Environment (keep *.example tracked) -----
.env
.env.*
!.env.example
!**/.env.example

# ----- Frontend (Next.js) -----
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/next-env.d.ts
**/*.tsbuildinfo

# ----- Backend -----
backend/dist/
backend/coverage/

# ----- Build / test output (any package) -----
dist/
build/
out/
coverage/
.turbo/
.cache/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- Editors / IDE -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ----- Misc / secrets -----
*.pem
*.key
*.cert
